<div class="chat-float-wrap">
    <button type="button" class="chat-float-toggle" id="chatFloatToggle" onclick="toggleChatFloat()" title="Mesajlaşma" aria-label="Mesajlaşma">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
        <span class="chat-float-badge" id="chatFloatBadge" hidden>0</span>
    </button>
    <div class="chat-float-panel" id="chatFloatPanel">
        <button type="button" class="chat-float-close" onclick="toggleChatFloat(false)" title="Kapat" aria-label="Kapat">✕</button>
        <%- include('chat-panel') %>
    </div>
</div>
