<div class="notif-wrap">
    <button type="button" class="notif-bell-btn" id="notifBellBtn" onclick="toggleNotifications()" title="Bildirimler" aria-label="Bildirimler">
        🔔
        <span class="notif-badge" id="notifBadge" hidden>0</span>
    </button>
    <div class="notif-panel" id="notifPanel" hidden>
        <div class="notif-panel-head">
            <span class="notif-panel-title">Bildirimler</span>
            <button type="button" class="notif-readall" id="notifReadAll" onclick="markAllNotificationsRead()">Tümünü okundu işaretle</button>
        </div>
        <div class="notif-list" id="notifList">
            <div class="notif-empty">Henüz bildirim yok.</div>
        </div>
    </div>
</div>
