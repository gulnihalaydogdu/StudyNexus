<section class="profile-section">
    <div class="section-head">
        <h2>Şifre Değiştir</h2>
        <p>Hesabınızı korumak için güçlü bir şifre kullanın</p>
    </div>
    <form action="/profile/password" method="POST" class="profile-form">
        <%- include('csrf-field') %>
        <label>Mevcut Şifre</label>
        <input type="password" name="currentPassword" autocomplete="current-password" required>

        <div class="form-row">
            <div>
                <label>Yeni Şifre</label>
                <input type="password" name="password" minlength="8" autocomplete="new-password" required>
            </div>
            <div>
                <label>Yeni Şifre (Tekrar)</label>
                <input type="password" name="passwordConfirm" minlength="8" autocomplete="new-password" required>
            </div>
        </div>
        <p class="field-hint">En az 8 karakter. Şifrenizi unuttuysanız <a href="/forgot-password">sıfırlama</a> sayfasını kullanın.</p>

        <div class="form-actions">
            <button type="submit" class="save-btn">Şifreyi Güncelle</button>
        </div>
    </form>
</section>
