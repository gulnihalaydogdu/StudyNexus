<div class="left-sidebar">
    <% if (weeklyPlans && weeklyPlans.length > 0) { %>
    <div class="plan-search-wrap">
        <input type="search" id="planSearchInput" class="plan-search-input"
               placeholder="🔍 Plan ara (başlık veya tarih)..." autocomplete="off"
               oninput="window.filterPlans(this.value)">
        <p id="planSearchEmpty" class="plan-search-empty" style="display:none;">Eşleşen plan bulunamadı.</p>
    </div>
    <% } %>
    <div class="pile-container">
        <% if (!weeklyPlans || weeklyPlans.length === 0) { %>
            <div class="pile-empty-state">
                <div style="font-size:3rem;margin-bottom:10px;opacity:0.5;">🗂️</div>
                <div class="pile-title" style="color:#a39fbb;">Kayıtlı Plan Yok</div>
                <div class="pile-date"><%= typeof pileEmptyHint !== 'undefined' ? pileEmptyHint : 'İlk haftalık planınızı oluşturup kaydedin.' %></div>
            </div>
        <% } else { weeklyPlans.forEach((plan, index) => { %>
            <div class="pile-paper"
                 style="--index:<%= index %>;"
                 data-plan-id="<%= plan.id %>"
                 data-open-plan
                 <% if (typeof studentViewId !== 'undefined') { %>data-student-plan-for="<%= studentViewId %>"<% } %>
                 role="button"
                 tabindex="0">
                <div class="pile-title"><%= plan.title %></div>
                <div class="pile-date"><%= plan.date_range %></div>
            </div>
        <% }) } %>
    </div>
    <% if (typeof hideCalendar === 'undefined' || !hideCalendar) { %>
    <div class="calendar-widget">
        <div class="cal-header"><h3>🗓️ Takvim</h3></div>
        <div class="cal-body">
            <% dynamicMonths.forEach(m => { %>
                <div class="cal-month-group">
                    <div class="cal-month-name"><%= m.name %> <%= m.year %></div>
                    <div class="cal-weeks-grid">
                        <% for(let w=1; w<=4; w++) {
                            let event = calendarEvents.find(e =>
                                e.target_year == m.year && e.target_month === m.name && e.target_week == w
                            );
                            if (event && !weeklyPlans.some(p => p.id === event.plan_id)) event = null;
                        %>
                            <div class="cal-week-box <%= event ? 'filled' : 'empty' %>"
                                 id="cal-box-<%= m.year %>-<%= m.name %>-<%= w %>"
                                 <% if (event) { %>
                                 data-plan-id="<%= event.plan_id %>"
                                 data-open-plan
                                 <% if (typeof studentViewId !== 'undefined') { %>data-student-plan-for="<%= studentViewId %>"<% } %>
                                 <% } %>>
                                <span class="week-num"><%= w %>. Hafta</span>
                                <% if(event) { %><div class="week-indicator"></div><% } %>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    <% } %>
</div>
