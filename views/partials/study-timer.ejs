<div id="studyTimer" class="study-timer">
    <div class="study-timer-head">
        <span class="study-timer-title">Çalışma Sayacı</span>
        <button type="button" class="study-timer-close" onclick="toggleStudyTimer(false)" title="Kapat">✕</button>
    </div>
    <div class="study-timer-clock" id="studyTimerClock">30:00</div>
    <div class="study-timer-status" id="studyTimerStatus">Hazır</div>
    <div class="study-timer-count" id="studyTimerCount">Bugün: 0 </div>
    <div class="study-timer-controls">
        <button type="button" id="studyTimerToggleBtn" class="st-btn primary" onclick="studyTimerStartPause()">Başlat</button>
        <button type="button" class="st-btn" onclick="studyTimerReset()">Sıfırla</button>
    </div>
    <div class="study-timer-presets">
        <button type="button" class="st-preset active" onclick="studyTimerSetPreset(30, 'Pomodoro', this)">🍅 Pomodoro · 30 dk</button>
        <button type="button" class="st-preset" onclick="studyTimerSetPreset(50, 'Ders', this)">📚 Ders · 50 dk</button>
        <button type="button" class="st-preset" onclick="studyTimerSetPreset(5, 'Kısa Mola', this, true)">☕ Kısa Mola · 5 dk</button>
        <button type="button" class="st-preset" onclick="studyTimerSetPreset(15, 'Uzun Mola', this, true)">🛋️ Uzun Mola · 15 dk</button>
    </div>
    <form class="study-timer-custom" onsubmit="event.preventDefault(); studyTimerSetCustom();">
        <input type="number" id="studyTimerCustomInput" min="1" max="600" step="1" placeholder="Dakika gir...">
        <button type="submit" class="st-btn primary">Ayarla</button>
    </form>
</div>
