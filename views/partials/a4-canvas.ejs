<div class="workspace">
    <div class="workspace-empty-state" id="workspaceEmptyState">
        <div class="welcome-poster-wrap">
            <img src="/img/eng-poster-bright.png" alt="Hoş Geldiniz" class="welcome-poster" id="welcomePoster"
                 <% if (typeof darkPoster !== 'undefined' && darkPoster) { %>
                 data-poster-light="/img/eng-poster-bright.png" data-poster-dark="/img/eng-poster-dark.png"
                 <% } %>>
        </div>
        <p class="workspace-hint"><%= typeof workspaceHint !== 'undefined' ? workspaceHint : 'Yeni plan oluşturmak için + butonuna tıklayın.' %></p>
    </div>
    <% if (typeof hideCreateBtn === 'undefined' || !hideCreateBtn) { %>
    <button class="add-btn" id="createNewBtn" type="button" title="Yeni plan">+</button>
    <img src="/img/arrow.jpg" alt="" class="welcome-arrow" id="welcomeArrow" aria-hidden="true">
    <% } %>
    <div class="a4-template a4-bright-paper" id="a4Canvas" data-editing-id="" data-read-only="0">
        <button type="button" class="cancel-canvas-btn" id="closeCanvasBtn">Vazgeç</button>
        <div class="a4-paper-export" id="a4PaperExport">
            <div class="a4-header">
                <input type="text" id="planTitleInput" placeholder="Plan Başlığı" class="plan-title-input">
                <input type="text" id="planDateInput" placeholder="Tarih (Örn: 18 Mayıs - 25 Mayıs)" class="plan-date-input">
            </div>
            <div class="planner-rows">
                <div class="day-row"><div class="day-letter" style="color:#ef4444;">P</div><div class="drop-zone" data-day="Pazartesi"></div></div>
                <div class="day-row"><div class="day-letter" style="color:#8b5cf6;">S</div><div class="drop-zone" data-day="Salı"></div></div>
                <div class="day-row"><div class="day-letter" style="color:#06b6d4;">Ç</div><div class="drop-zone" data-day="Çarşamba"></div></div>
                <div class="day-row"><div class="day-letter" style="color:#d946ef;">P</div><div class="drop-zone" data-day="Perşembe"></div></div>
                <div class="day-row"><div class="day-letter" style="color:#f59e0b;">C</div><div class="drop-zone" data-day="Cuma"></div></div>
                <div class="day-row"><div class="day-letter" style="color:#10b981;">C</div><div class="drop-zone" data-day="Cumartesi"></div></div>
                <div class="day-row"><div class="day-letter" style="color:#f97316;">P</div><div class="drop-zone" data-day="Pazar"></div></div>
            </div>
        </div>
        <div class="canvas-toolbar canvas-toolbar-bottom">
            <div class="canvas-toolbar-group">
                <button type="button" class="save-plan-btn" id="savePlanBtn">💾 Kaydet</button>
                <button type="button" class="download-pdf-btn" id="downloadPdfBtn">📥 <%= typeof compactToolbar !== 'undefined' && compactToolbar ? 'PDF' : 'PDF İndir' %></button>
                <button type="button" class="canvas-action-btn danger" id="deletePlanBtn" style="display:none;">🗑️ Sil</button>
                <button type="button" class="canvas-action-btn" id="calendarPlanBtn" style="display:none;">📅 Takvime Ekle</button>
                <% if (typeof showAssignBtn !== 'undefined' && showAssignBtn) { %>
                <button type="button" class="canvas-action-btn accent" id="assignPlanBtn" style="display:none;">📤 Öğrenciye Ata</button>
                <% } %>
            </div>
        </div>
    </div>
</div>
