<aside class="toolbox toolbox-readonly">
    <div class="toolbox-drag-panel action-card">
        <h3>📘 Öğrencinin Dersleri</h3>
        <p class="toolbox-readonly-hint">Salt okunur — öğrencinin kendi listesi.</p>
        <% if (!courses || courses.length === 0) { %>
            <p class="week-panel-empty">Henüz ders eklenmemiş.</p>
        <% } else { %>
            <div class="course-tags-wrapper">
                <span class="tags-title">Dersler</span>
                <div id="courseTagsContainer" class="tags-container">
                    <% courses.forEach(course => { %>
                        <div class="course-pill readonly-pill" data-course-id="<%= course.id %>" onclick="selectCourseInCombo(<%= course.id %>)" role="button" tabindex="0">
                            <span class="pill-text"><%= course.name %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="unassigned-topics topics-scroll">
                <h3>📌 Konular</h3>
                <p id="topicsFilterEmpty" class="topics-filter-empty" style="display:none;">Bu derste konu yok.</p>
                <div class="draggable-list readonly-topics" id="topicsContainer">
                    <% topics.forEach(topic => { %>
                        <div class="draggable-item readonly-item<%= topic.is_completed ? ' is-done' : '' %>"
                             data-course-id="<%= topic.course_id %>">
                            <span class="topic-label<%= topic.is_completed ? ' done' : '' %>">
                                <small class="topic-course-tag"><%= topic.course_name %></small>
                                <%= topic.name %>
                            </span>
                            <% if (topic.is_completed) { %><span class="topic-done-badge">✓</span><% } %>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>
</aside>
