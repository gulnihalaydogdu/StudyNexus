<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyNexus - Şifremi Unuttum</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="auth-graphic">
        <h1>StudyNexus</h1>
        <p>Şifrenizi sıfırlamak için kayıtlı e-posta adresinizi girin.</p>
    </div>
    <div class="auth-form-section">
        <div class="auth-box">
            <h2>Şifremi Unuttum</h2>
            <% if (message) { %><p class="subtitle" style="color:#10b981;"><%= message %></p><% } %>
            <form action="/forgot-password" method="POST">
                <input type="email" name="email" placeholder="E-posta adresiniz" required>
                <button type="submit">Sıfırlama linki gönder</button>
            </form>
            <div class="switch-link"><a href="/login">Giriş sayfasına dön</a></div>
        </div>
    </div>
</body>
</html>
