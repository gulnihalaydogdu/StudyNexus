<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyNexus - Şifremi Unuttum</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="auth-graphic">
        <h1>StudyNexus</h1>
        <p>Şifrenizi sıfırlamak için kayıtlı e-posta adresinizi girin.</p>
    </div>
    <div class="auth-form-section">
        <div class="auth-box">
            <h2>Şifremi Unuttum</h2>
            <% if (typeof message !== 'undefined' && message) { %><p class="subtitle" style="color:#10b981;"><%= message %></p><% } %>
            <% if (typeof error !== 'undefined' && error) { %><p class="subtitle" style="color:#ef4444;"><%= error %></p><% } %>
            <% const f = typeof form !== 'undefined' && form ? form : {}; %>
            <% const errField = typeof fieldError !== 'undefined' ? fieldError : ''; %>
            <form action="/forgot-password" method="POST">
                <%- include('partials/csrf-field') %>
                <input type="email" name="email" placeholder="E-posta adresiniz" value="<%= f.email || '' %>" class="<%= errField === 'email' ? 'field-error' : '' %>" required>
                <button type="submit">Sıfırlama linki gönder</button>
            </form>
            <div class="switch-link"><a href="/login">Giriş sayfasına dön</a></div>
        </div>
    </div>
</body>
</html>
