<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyNexus — Öğrenci</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <%- include('partials/csrf-meta') %>
</head>
<body class="role-student">
<header class="navbar">
    <h1 class="brand">StudyNexus</h1>
    <nav class="app-nav" data-default-panel="planner">
        <button type="button" class="nav-chip active" data-panel="planner">📝 Planlarım</button>
        <button type="button" class="nav-chip" data-panel="week">📋 Bu Hafta</button>
        <button type="button" class="nav-chip" data-panel="stats">📊 İlerleme</button>
        <button type="button" class="nav-chip" data-panel="coaching">👩‍🏫 Koçum</button>
    </nav>
    <div class="user-menu">
        <%- include('partials/notification-bell') %>
        <button type="button" class="timer-toggle-btn" id="timerToggleBtn" onclick="toggleStudyTimer()" title="Çalışma sayacı">⏱️</button>
        <a href="/profile" class="profile-link">👤 <%= user.username %> <span class="role-tag">Öğrenci</span></a>
        <a href="/logout" class="logout-btn">Çıkış</a>
    </div>
</header>

<%- include('partials/study-timer') %>

<main class="app-shell">
    <section id="panel-planner" class="app-panel active">
        <div class="canvas-area">
            <%- include('partials/planner-sidebar') %>
            <%- include('partials/a4-canvas', { workspaceHint: 'Haftalık planınızı oluşturun veya soldan bir plana tıklayın.', showAssignBtn: false }) %>
            <%- include('partials/topic-toolbox') %>
        </div>
    </section>

    <section id="panel-week" class="app-panel">
        <div class="panel-center-card">
            <h2>📋 Bu Hafta — <%= weekPanel.todayName %></h2>
            <% if (!weekPanel.hasPlan) { %>
                <p class="week-panel-empty">Bu ayın <%= weekPanel.week %>. haftası için takvimde atanmış plan yok.</p>
            <% } else { %>
                <p class="week-panel-sub"><%= weekPanel.planTitle %> · <%= weekPanel.month %> · <%= weekPanel.week %>. Hafta</p>
                <% if (weekPanel.todayItems.length === 0) { %>
                    <p class="week-panel-empty">Bugün için planlanmış konu yok.</p>
                <% } else { %>
                    <ul class="week-task-list" id="weekTaskList">
                        <% weekPanel.todayItems.forEach(item => { %>
                            <li class="<%= item.daily_completed ? 'is-done' : '' %>" data-week-item-id="<%= item.id %>">
                                <button
                                    type="button"
                                    class="week-task-toggle"
                                    onclick="toggleWeekItemDone(<%= item.id %>, <%= item.daily_completed ? 'false' : 'true' %>, this)"
                                    title="<%= item.daily_completed ? 'Geri al' : 'Bugün tamamlandı' %>">
                                    <%= item.daily_completed ? '✓' : '○' %>
                                </button>
                                <span class="week-task-content">
                                    <strong><%= item.course_name %></strong> — <%= item.topic_name %>
                                    <% if (item.description) { %><span class="week-task-desc"><%= item.description %></span><% } %>
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            <% } %>
        </div>
    </section>

    <section id="panel-stats" class="app-panel">
        <div class="panel-center-card stats-card-wide">
            <h2>📊 İlerleme</h2>
            <div class="gamification-card" id="gamificationCard">
                <div class="gamification-main">
                    <div class="gamification-head">
                        <div>
                            <span class="gamification-kicker">Seviye <span id="gamiLevel"><%= gamification.level %></span></span>
                            <strong><span id="gamiXp"><%= gamification.xp %></span> XP</strong>
                            <p class="stats-muted"><span id="gamiStreak"><%= gamification.streak %></span> günlük seri</p>
                        </div>
                        <div class="gamification-mascot">
                            <img id="gamiMascot" src="/img/xp-mascot.gif" alt=""
                                 onerror="this.style.display='none'">
                        </div>
                    </div>
                    <div class="xp-bar-wrap">
                        <div class="xp-bar-track">
                            <div class="xp-bar-fill" id="gamiXpBar" style="width: <%= gamification.levelProgressPercent %>%;">
                                <span class="xp-bar-shine"></span>
                            </div>
                        </div>
                        <div class="xp-bar-meta">
                            <span id="gamiXpInto"><%= gamification.xpIntoLevel %></span> / <span id="gamiXpFor"><%= gamification.xpForLevel %></span> XP
                            <span class="xp-bar-next">· Sonraki seviyeye <span id="gamiXpToNext"><%= gamification.xpToNext %></span> XP</span>
                        </div>
                    </div>
                </div>
                <div class="badge-row" id="gamiBadges">
                    <% if (!gamification.badges.length) { %>
                        <span class="badge-pill muted">Rozetler yakında</span>
                    <% } else { gamification.badges.forEach(b => { %>
                        <span class="badge-pill"><%= b.icon %> <%= b.label %></span>
                    <% }) } %>
                </div>
            </div>
            <div class="stats-overall">
                <div class="stats-ring" id="statsRing" style="--p: <%= stats.overallPercent %>;">
                    <span id="statsPercentText"><%= stats.overallPercent %>%</span>
                </div>
                <div>
                    <strong id="statsCountText"><%= stats.completedTopics %> / <%= stats.totalTopics %></strong>
                    <p class="stats-muted">konu tamamlandı</p>
                </div>
            </div>
            <div id="statsCourseRows">
                <% stats.byCourse.forEach(c => { %>
                    <div class="stats-course-row" data-course-id="<%= c.id %>">
                        <span><%= c.name %></span>
                        <div class="stats-bar"><div class="stats-bar-fill" style="width:<%= c.percent %>%"></div></div>
                        <span class="stats-pct"><%= c.percent %>%</span>
                    </div>
                <% }) %>
            </div>
            <div class="stats-trend-card">
                <div class="stats-trend-head">
                    <h3>Son İlerleme</h3>
                    <span>Günlük trend</span>
                </div>
                <div class="stats-trend-bars" id="statsTrendBars">
                    <% if (!stats.trend || stats.trend.length === 0) { %>
                        <p class="stats-muted">Trend için birkaç tamamlama kaydı oluşmalı.</p>
                    <% } else { %>
                        <% stats.trend.forEach(point => { %>
                            <div class="trend-bar-item" title="<%= point.snapshot_date %> · <%= point.overall_percent %>%">
                                <div class="trend-bar-track">
                                    <div class="trend-bar-fill" style="height:<%= Math.max(6, point.overall_percent) %>%"></div>
                                </div>
                                <span><%= point.snapshot_date.slice(5) %></span>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <section id="panel-coaching" class="app-panel">
        <div class="panel-center-card">
            <h2>👩‍🏫 Koçuma Bağlan</h2>
            <p class="coaching-hint">Koçunuzun verdiği kodu girerek programa erişim ve plan atamaları alırsınız.</p>
            <form class="coaching-form" onsubmit="event.preventDefault(); linkToCoach();">
                <input type="text" id="coachCodeInput" placeholder="Koç kodu" required style="text-transform:uppercase;">
                <button type="submit" class="daily-submit-btn">Bağlan</button>
            </form>
            <ul id="myTeachersList" class="coaching-list"></ul>
            <div class="student-feedback-box">
                <h3>Koç Geri Bildirimleri</h3>
                <ul id="studentFeedbackList" class="feedback-list"></ul>
            </div>
        </div>
    </section>
</main>

<% if (flashMsg) { %>
    <div class="toast-message" id="toastMsg"><%= flashMsg %></div>
<% } %>
<%- include('partials/modals') %>

<script>window.STUDYNEXUS_USER = { id: <%= user.id %>, role: 'student' };</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script type="module" src="/js/app.js"></script>
</body>
</html>
