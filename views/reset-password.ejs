<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyNexus - Yeni Şifre</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="auth-graphic">
        <h1>StudyNexus</h1>
        <p>Yeni şifrenizi belirleyin.</p>
    </div>
    <div class="auth-form-section">
        <div class="auth-box">
            <h2>Yeni Şifre</h2>
            <% if (typeof error !== 'undefined' && error) { %>
                <p class="subtitle" style="color:#ef4444;"><%= error %></p>
            <% } %>
            <form action="/reset-password" method="POST">
                <%- include('partials/csrf-field') %>
                <input type="hidden" name="token" value="<%= token %>">
                <input type="password" name="password" placeholder="Yeni şifre" required minlength="8">
                <input type="password" name="passwordConfirm" placeholder="Şifre tekrar" required minlength="8">
                <button type="submit">Şifreyi güncelle</button>
            </form>
        </div>
    </div>
</body>
</html>
