<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= student.full_name || student.username %> — StudyNexus</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <%- include('partials/csrf-meta') %>
</head>
<body class="role-teacher teacher-student-page" data-student-view-id="<%= student.id %>">
<header class="navbar">
    <div class="teacher-student-nav-left">
        <a href="/" class="back-dashboard-link">← Öğrencilerim</a>
        <h1 class="brand brand-inline"><%= student.full_name || student.username %></h1>
        <% if (student.grade) { %><span class="student-grade-tag"><%= student.grade %></span><% } %>
    </div>
    <div class="teacher-student-nav-stats">
        <div class="stats-ring stats-ring-sm" style="--p: <%= stats.percent %>;">
            <span><%= stats.percent %>%</span>
        </div>
        <span class="stats-inline-text"><%= stats.completedTopics %> / <%= stats.totalTopics %> konu</span>
    </div>
    <div class="user-menu">
        <a href="/profile" class="profile-link">👤 <%= user.username %></a>
        <a href="/logout" class="logout-btn">Çıkış</a>
    </div>
</header>

<main class="app-shell teacher-student-main">
    <p class="teacher-student-hint">Öğrencinin kayıtlı programları ve takvimi. Bir plana veya takvim haftasına tıklayarak tam tuvalde görüntüleyin.</p>
    <section class="teacher-feedback-panel action-card">
        <div>
            <h2>Geri Bildirim</h2>
            <p class="coaching-hint">Öğrenciye kısa bir yönlendirme veya motivasyon notu bırakın.</p>
        </div>
        <form class="feedback-form" onsubmit="event.preventDefault(); submitStudentFeedback(<%= student.id %>);">
            <textarea id="studentFeedbackInput" maxlength="600" placeholder="Örn: Bu hafta kimya tekrarına öncelik ver, iyi gidiyorsun."></textarea>
            <button type="submit" class="daily-submit-btn">Gönder</button>
        </form>
        <ul id="teacherFeedbackList" class="feedback-list">
            <% if (!feedback.length) { %>
                <li>Henüz geri bildirim yok.</li>
            <% } else { feedback.forEach(item => { %>
                <li><strong><%= item.teacher_name || item.teacher_username %></strong>: <%= item.message %></li>
            <% }) } %>
        </ul>
    </section>
    <div class="canvas-area">
        <%- include('partials/planner-sidebar', {
            weeklyPlans,
            calendarEvents,
            dynamicMonths,
            studentViewId: student.id,
            pileEmptyHint: 'Bu öğrencinin henüz kayıtlı planı yok.'
        }) %>
        <%- include('partials/a4-canvas', {
            workspaceHint: 'Soldan bir plan seçin veya takvimdeki haftaya tıklayın.',
            showAssignBtn: false,
            hideCreateBtn: true
        }) %>
        <%- include('partials/topic-toolbox-readonly', { courses, topics }) %>
    </div>
</main>

<script>
window.STUDYNEXUS_USER = { id: <%= user.id %>, role: 'teacher' };
window.STUDYNEXUS_VIEW = {
    mode: 'teacher-student',
    studentId: <%= student.id %>,
    studentName: <%- JSON.stringify(student.full_name || student.username) %>,
    readOnly: true
};
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script type="module" src="/js/app.js"></script>
</body>
</html>
