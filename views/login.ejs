<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyNexus - Giriş Yap</title>
    <%- include('partials/theme-init') %>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
    <div class="auth-theme-toggle"><%- include('partials/theme-toggle') %></div>
    
    <div class="auth-graphic">
        <h1>StudyNexus</h1>
        <p>Geleceğini planla, hedeflerine ulaş. Öğrenciler ve öğretmenler için tasarlanmış akıllı eğitim asistanı.</p>
    </div>

    <div class="auth-form-section">
        <div class="auth-box">
            <h2>Hoş Geldin 👋</h2>
            <p class="subtitle">Çalışmalarına kaldığın yerden devam et.</p>
            <% if (typeof flash !== 'undefined' && flash) { %>
                <p class="subtitle" style="color:#10b981;"><%= flash %></p>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <p class="subtitle" style="color:#ef4444;"><%= error %></p>
            <% } %>
            
            <% const f = typeof form !== 'undefined' && form ? form : {}; %>
            <% const errField = typeof fieldError !== 'undefined' ? fieldError : ''; %>
            <form action="/login" method="POST">
                <%- include('partials/csrf-field') %>
                <input type="text" name="username" placeholder="Kullanıcı Adı" value="<%= f.username || '' %>" class="<%= errField === 'username' ? 'field-error' : '' %>" required>
                <input type="password" name="password" placeholder="Şifre" class="<%= errField === 'password' ? 'field-error' : '' %>" required>
                <button type="submit">Giriş Yap</button>
            </form>
            
            <div class="switch-link" style="margin-top:12px;">
                <a href="/forgot-password">Şifremi unuttum</a>
            </div>
            <div class="switch-link">
                Hesabın yok mu? <a href="/register">Hemen Kayıt Ol</a>
            </div>
        </div>
    </div>

<script src="/js/theme.js" defer></script>
</body>
</html>