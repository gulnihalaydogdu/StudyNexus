<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyNexus — Öğretmen</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <%- include('partials/csrf-meta') %>
</head>
<body class="role-teacher">
<header class="navbar">
    <h1 class="brand">StudyNexus <span class="brand-sub">Koç Paneli</span></h1>
    <nav class="app-nav" data-default-panel="students">
        <button type="button" class="nav-chip active" data-panel="students">🎯 Öğrencilerim</button>
        <button type="button" class="nav-chip" data-panel="planner">📝 Plan Oluştur</button>
    </nav>
    <div class="user-menu">
        <a href="/profile" class="profile-link">👤 <%= user.username %> <span class="role-tag">Öğretmen</span></a>
        <a href="/logout" class="logout-btn">Çıkış</a>
    </div>
</header>

<main class="app-shell">
    <section id="panel-students" class="app-panel active">
        <div class="teacher-home">
            <div class="teacher-hero">
                <div class="teacher-hero-text">
                    <span class="teacher-hero-kicker">Koç Paneli</span>
                    <h2>Merhaba, <%= user.username %> 👋</h2>
                    <p>Öğrencilerinin gelişimini takip et, haftalık plan oluştur ve tek tıkla ata.</p>
                    <div class="teacher-hero-actions">
                        <button type="button" class="hero-btn primary" onclick="window.showAppPanel('planner')">📝 Plan Oluştur</button>
                        <button type="button" class="hero-btn ghost" id="heroCopyCode">📋 Davet Kodunu Kopyala</button>
                    </div>
                </div>
                <div class="teacher-hero-stat">
                    <strong id="teacherStudentCount">—</strong>
                    <span>öğrenci</span>
                </div>
            </div>

            <div class="teacher-invite-card action-card">
                <h2>Öğrenci Davet Kodu</h2>
                <p class="coaching-hint">Öğrencileriniz bu kodu <strong>Koçum</strong> sekmesinden girerek size bağlanır.</p>
                <code id="coachCodeDisplay" class="invite-code-big">...</code>
            </div>

            <div class="teacher-guide-card action-card">
                <h2>Nasıl çalışır?</h2>
                <ol class="teacher-steps">
                    <li><span class="step-num">1</span> Davet kodunu öğrencinle paylaş.</li>
                    <li><span class="step-num">2</span> <strong>Plan Oluştur</strong> sekmesinden haftalık plan hazırla.</li>
                    <li><span class="step-num">3</span> Planı kaydedip öğrencine ata.</li>
                    <li><span class="step-num">4</span> Aşağıdaki kartlardan ilerlemeyi takip et ve geri bildirim ver.</li>
                </ol>
            </div>

            <div class="teacher-students-card action-card">
                <div class="teacher-card-head">
                    <h2>Öğrencilerim</h2>
                    <span class="teacher-card-sub" id="teacherStudentsSub"></span>
                </div>
                <ul id="teacherStudentsList" class="coaching-list teacher-student-grid"></ul>
            </div>
        </div>
    </section>

    <section id="panel-planner" class="app-panel">
        <div class="canvas-area">
            <%- include('partials/planner-sidebar', { hideCalendar: true, weeklyPlans, calendarEvents, dynamicMonths }) %>
            <%- include('partials/a4-canvas', { workspaceHint: 'Öğrencilere atayacağınız haftalık planı burada oluşturun.', showAssignBtn: true, compactToolbar: true }) %>
            <%- include('partials/topic-toolbox') %>
        </div>
    </section>
</main>

<% if (flashMsg) { %>
    <div class="toast-message" id="toastMsg"><%= flashMsg %></div>
<% } %>
<%- include('partials/modals') %>

<script>window.STUDYNEXUS_USER = { id: <%= user.id %>, role: 'teacher' };</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script type="module" src="/js/app.js"></script>
</body>
</html>
