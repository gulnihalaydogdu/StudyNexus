<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyNexus — <%= pageTitle %></title>
    <%- include('partials/theme-init') %>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

    <div class="profile-page">
        <header class="profile-top">
            <div>
                <h1>Hesap Ayarları</h1>
                <p><%= pageSubtitle %></p>
            </div>
            <div class="profile-top-actions">
                <%- include('partials/theme-toggle') %>
                <a href="/" class="profile-home-link">← Ana sayfa</a>
            </div>
        </header>

        <div class="profile-layout">
            <main class="profile-main">
                <% if (flashMsg) { %>
                    <div class="profile-flash <%= flashType === 'error' ? 'error' : 'success' %>" role="alert">
                        <%= flashMsg %>
                    </div>
                <% } %>

                <% if (activeTab === 'personal') { %>
                    <%- include('partials/profile-personal') %>
                <% } else if (activeTab === 'password') { %>
                    <%- include('partials/profile-password') %>
                <% } else if (activeTab === 'email') { %>
                    <%- include('partials/profile-email') %>
                <% } else if (activeTab === 'delete') { %>
                    <%- include('partials/profile-delete') %>
                <% } %>
            </main>

            <%- include('partials/profile-nav') %>
        </div>
    </div>

<script src="/js/theme.js" defer></script>
</body>
</html>
