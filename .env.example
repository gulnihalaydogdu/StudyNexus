PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=degistirin_guclu_bir_deger

# Gmail uygulama şifresi olarak (https://myaccount.google.com/apppasswords)
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# false = mail olmadan kayıt engellenir (production)
REQUIRE_MAIL=true

# Yalnızca yerel geliştirme: mail yokken otomatik doğrulama
AUTO_VERIFY_WHEN_NO_MAIL=false

# Hatırlatıcılar: sunucu açıldıktan sonra ilk kontrol ve tekrar aralığı (ms)
REMINDER_INITIAL_DELAY_MS=15000
REMINDER_INTERVAL_MS=3600000
